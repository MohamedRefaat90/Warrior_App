# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Lane For Firebase Distribution"
  lane :fbd do
    # Verify environment variables
    firebase_token = ENV["FIREBASE_CLI_TOKEN"]
    if firebase_token.nil? || firebase_token.empty?
      UI.user_error!("FIREBASE_CLI_TOKEN environment variable is not set or empty")
    end
    
    # Clean and build
    sh "flutter clean"
    
    # Clear Gradle caches to resolve Kotlin version conflicts
    UI.message("Clearing Gradle caches...")
    begin
      sh "cd android && ./gradlew clean --no-daemon"
    rescue => exception
      UI.important("Gradle clean failed, continuing anyway: #{exception.message}")
    end
    
    sh "flutter build apk --release"
    
    # Debug: Show current directory and build output
    UI.message("Current working directory: #{Dir.pwd}")
    UI.message("Build output structure:")
    sh "find .. -name 'build' -type d 2>/dev/null | head -5 || echo 'No build directories found'"
    UI.message("Looking for APK files...")
    sh "find .. -name '*.apk' -type f 2>/dev/null || echo 'No APK found with find command'"
    
    # Verify APK exists
    apk_path = "../build/app/outputs/flutter-apk/app-release.apk"
    
    # Try different possible paths since the build might be in different locations
    possible_paths = [
      "../build/app/outputs/flutter-apk/app-release.apk",
      "../../build/app/outputs/flutter-apk/app-release.apk",
      File.expand_path("../build/app/outputs/flutter-apk/app-release.apk"),
      File.expand_path("../../build/app/outputs/flutter-apk/app-release.apk")
    ]
    
    apk_path = possible_paths.find { |path| File.exist?(path) }
    
    unless apk_path
      UI.error("APK file not found in any of these locations:")
      possible_paths.each { |path| UI.error("  - #{path}") }
      UI.user_error!("APK build might have failed or APK is in an unexpected location")
    end
    
    UI.message("Found APK at: #{apk_path}")
    
    # Get APK size for logging
    apk_size = File.size(apk_path) / (1024.0 * 1024.0)
    UI.message("APK size: #{apk_size.round(2)} MB")
    
    begin
      firebase_app_distribution(
        app: "1:466603345246:android:a4d0161c402a1bd30a3bcf",
        firebase_cli_token: firebase_token,
        android_artifact_type: "APK",
        apk_path: apk_path,
        testers: "bombotuf15@gmail.com,mohamedbfc700@gmail.com,momenrefat977@gmail.com,ahmedkok980@gmail.com",
        release_notes: "Automated release from CI/CD pipeline - Build #{Time.now.strftime('%Y%m%d-%H%M')}",
        debug: true
      )
      UI.success("🎉 Firebase App Distribution upload successful!")
    rescue => exception
      UI.error("❌ Firebase App Distribution failed: #{exception.message}")
      UI.important("Please check:")
      UI.important("1. Firebase App Distribution is enabled in your Firebase console")
      UI.important("2. The app ID '1:466603345246:android:a4d0161c402a1bd30a3bcf' exists in your project")
      UI.important("3. The service account has 'Firebase App Distribution Admin' role")
      UI.important("4. The FIREBASE_CLI_TOKEN has proper permissions")
      raise exception
    end
  end

  desc "Get version name from build.gradle"
  private_lane :get_version_name do
    # Try different possible paths for build.gradle
    possible_gradle_paths = [
      "app/build.gradle",
      "../app/build.gradle",
      File.expand_path("../app/build.gradle"),
      File.expand_path("../../android/app/build.gradle")
    ]
    
    gradle_path = possible_gradle_paths.find { |path| File.exist?(path) }
    
    unless gradle_path
      UI.error("build.gradle not found in any of these locations:")
      possible_gradle_paths.each { |path| UI.error("  - #{path}") }
      return "unknown"
    end
    
    UI.message("Reading version from: #{gradle_path}")
    gradle_file = File.read(gradle_path)
    version_match = gradle_file.match(/versionName\s*[=:]\s*"([^"]+)"/)
    version_match ? version_match[1] : "unknown"
  end

  desc "Build release APK only"
  lane :build_release do
    sh "flutter clean"
    sh "flutter build apk --release"
    
    # Try different possible paths
    possible_paths = [
      "../build/app/outputs/flutter-apk/app-release.apk",
      "../../build/app/outputs/flutter-apk/app-release.apk",
      File.expand_path("../build/app/outputs/flutter-apk/app-release.apk"),
      File.expand_path("../../build/app/outputs/flutter-apk/app-release.apk")
    ]
    
    apk_path = possible_paths.find { |path| File.exist?(path) }
    
    if apk_path
      apk_size = File.size(apk_path) / (1024.0 * 1024.0)
      UI.success("✅ APK built successfully: #{apk_size.round(2)} MB at #{apk_path}")
    else
      UI.error("APK file not found in any of these locations:")
      possible_paths.each { |path| UI.error("  - #{path}") }
      UI.user_error!("❌ APK build failed - file not found")
    end
  end
end
