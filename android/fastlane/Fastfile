# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Lane For Firebase Distribution"
  lane :fbd do |options|
    release_notes = options[:release_notes] || "Bug fixes and improvements"
    
    sh "flutter clean"
    sh "flutter build apk --release"
    firebase_app_distribution(
      app: "1:466603345246:android:810666c6db8b75510a3bcf",
      # Option 1: Use CLI token (requires Node.js upgrade)
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-release.apk",
      testers: "bombotuf15@gmail.com,mohamedbfc700@gmail.com,momenrefat977@gmail.com,ahmedkok980@gmail.com",
      release_notes: release_notes,
    )
  
    # sh "your_script.sh"
    
  end

  desc "Deploy to Google Play Store"
  lane :deploy_to_play_store do |options|
    track = options[:track] || "internal"
    release_notes = "Bug fixes and improvements"
    
    # Log the release notes for reference
    UI.message("📝 Release Notes: #{release_notes}")
    
    # Ensure bundle is already built by the workflow
    upload_to_play_store(
      track: track,
      release_status: track == "production" ? "completed" : "draft",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_KEY"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    
    UI.success("🚀 App successfully uploaded to Google Play Store (#{track} track)")
    UI.important("⚠️  Don't forget to add release notes manually in Google Play Console!")
  end

  desc "Build Release Bundle for Play Store"
  lane :build_release do
    sh "flutter clean"
    sh "flutter build appbundle --release"
  end

end